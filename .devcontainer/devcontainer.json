{
  "name": "SkillScope web and FastAPI",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "web/src/main.jsx"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "corepack enable && corepack prepare pnpm@11.0.0 --activate && pnpm --dir web install --frozen-lockfile && python -m pip install --user -r requirements.txt -r requirements-api.txt",
  "postAttachCommand": {
    "application": "npm run dev:container"
  },
  "portsAttributes": {
    "5173": {
      "label": "SkillScope web app",
      "onAutoForward": "openPreview"
    },
    "3000": {
      "label": "Node.js gateway"
    },
    "8000": {
      "label": "FastAPI service"
    }
  },
  "forwardPorts": [
    3000,
    5173,
    8000
  ]
}
